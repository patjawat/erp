{
    "name": "yiisoft/yii2-app-basic",
    "description": "Yii 2 Basic Project Template",
    "keywords": [
        "yii2",
        "framework",
        "basic",
        "project template"
    ],
    "homepage": "http://www.yiiframework.com/",
    "type": "project",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/yiisoft/yii2/issues?state=open",
        "forum": "http://www.yiiframework.com/forum/",
        "wiki": "http://www.yiiframework.com/wiki/",
        "irc": "irc://irc.freenode.net/yii",
        "source": "https://github.com/yiisoft/yii2"
    },
    "minimum-stability": "dev",
    "require": {
        "php": ">=7.4.0",
        "yiisoft/yii2": "~2.0.50",
        "yiisoft/yii2-bootstrap4": "~2.0.0",
        "yiisoft/yii2-bootstrap5": "*",
        "yiisoft/yii2-swiftmailer": "~2.0.0 || ~2.1.0",
        "kartik-v/yii2-widgets": "*",
        "kartik-v/yii2-datecontrol": "dev-master",
        "dektrium/yii2-user": "^0.9.14",
        "dektrium/yii2-rbac": "1.0.0-alpha@dev",
        "mdmsoft/yii2-admin": "~2.0",
        "mdmsoft/yii2-autonumber": "~1.0",
        "kartik-v/yii2-widget-activeform": "dev-master",
        "kartik-v/yii2-grid": "dev-master",
        "kartik-v/yii2-mpdf": "dev-master",
        "kartik-v/yii2-widget-select2": "dev-master",
        "kartik-v/yii2-widget-datepicker": "dev-master",
        "kartik-v/yii2-editors": "dev-master",
        "kartik-v/yii2-editable": "*",
        "kartik-v/yii2-bootstrap4-dropdown": "@dev",
        "dominus77/yii2-sweetalert2-widget": "~1.3",
        "dixonsatit/yii2-thai-year-formatter": "*",
        "kartik-v/yii2-bootstrap5-dropdown": "@dev",
        "twbs/bootstrap-icons": "^1.10",
        "google/apiclient": "^2.0@dev",
        "yiisoft/yii2-authclient": "^2.2",
        "iamsaint/yii2-datetimepicker": "dev-master",
        "kartik-v/yii2-tree-manager": "dev-master",
        "creocoder/yii2-nested-sets": "dev-master",
        "ruskid/yii2-csv-importer": "dev-master",
        "yiithings/yii2-dotenv": "dev-master",
        "nick-denry/yii2-round-switch-column": "^0.1.2",
        "unclead/yii2-multiple-input": "^2.26",
        "phpoffice/phpword": "dev-master",
        "yiisoft/yii2-imagine": "~2.2.0",
        "softark/yii2-dual-listbox": "dev-master",
        "kartik-v/yii2-popover-x": "dev-master",
        "edofre/yii2-fullcalendar": "V1.0.11",
        "asyou99/yii2-cart": "@dev",
        "kartik-v/yii2-sortable": "dev-master",
        "phpoffice/phpspreadsheet": "dev-master",
        "setasign/fpdf": "^1.9.0",
        "tecnickcom/tcpdf": "dev-main",
        "mpdf/mpdf": "^8.2",
        "setasign/fpdi": "^2.6",
        "2amigos/yii2-qrcode-helper": "^3.1",
        "guzzlehttp/guzzle": "^7.12.1",
        "endroid/qr-code": "^4.6"
    },
    "require-dev": {
        "yiisoft/yii2-debug": "~2.1.0",
        "yiisoft/yii2-gii": "~2.2.0",
        "yiisoft/yii2-faker": "~2.0.0",
        "warrence/yii2-kartikgii": "dev-master",
        "coderius/yii2-hit-counter": "dev-master",
        "codeception/codeception": "^5.0.8",
        "codeception/module-asserts": "~3.1.0",
        "codeception/module-yii2": "^1.1.12",
        "codeception/module-filesystem": "^3.0",
        "codeception/verify": "^2.2"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "platform-check": false,
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "process-timeout": 0,
        "fxp-asset": {
            "enabled": false
        }
    },
    "prefer-stable": true,
    "scripts": {
        "post-install-cmd": [
            "yii\\composer\\Installer::postInstall"
        ],
        "post-create-project-cmd": [
            "yii\\composer\\Installer::postCreateProject",
            "yii\\composer\\Installer::postInstall"
        ]
    },
    "extra": {
        "yii\\composer\\Installer::postCreateProject": {
            "setPermission": [
                {
                    "runtime": "0777",
                    "web/assets": "0777",
                    "yii": "0755"
                }
            ]
        },
        "yii\\composer\\Installer::postInstall": {
            "generateCookieValidationKey": [
                "config/web.php"
            ]
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
