# ตั้งค่า webapp
IMAGE_NAME=erp:v1
# ช่องทางอัปเดต: stable = เวอร์ชันที่ปล่อยแล้ว (แนะนำ) / latest = รุ่นทดสอบ / v1.28.0 = ตรึงเวอร์ชัน
APP_IMAGE=patjawat/erp:stable
APP_PORT=80
CONTAINER_NAME=dansai
HOS_CODE=11447
PAM_PORT=8000

# phpmyadmin
MYSQL_ROOT_PASSWORD=docker
MYSQL_PASSWORD=docker
MYSQL_PORT=3307

# connect database
DB_NAME=dansai
DB_DSN=mysql:host=mysqlDB;dbname=dansai
DB_USERNAME=root
DB_PASS=docker
